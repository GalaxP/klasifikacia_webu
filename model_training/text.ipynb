	" if heading_text:\n",
	" important_parts.extend([heading_text] * 2)\n",
	"\n",
	" main_text = self._extract_main_text_trafilatura(str(soup))\n",
	" if not main_text:\n",
	" main_candidates = []\n",
	"\n",
	" for selector in [\n",
	" "main",\n",
	" "article",\n",
