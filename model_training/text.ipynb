	"def load_jsonl(filepath: str) -> pd.DataFrame:\n",
	" records: List[Dict[str, Any]] = []\n",
	" with open(filepath, "r", encoding="utf-8") as file:\n",
	" for line_number, line in enumerate(file, start=1):\n",
	" line = line.strip()\n",
	" if not line:\n",
	" continue\n",
	" try:\n",
	" records.append(json.loads(line))\n",
	" except json.JSONDecodeError:\n",
	" print(f"Preskakujem chybný JSON na riadku {line_number}.")\n",
	" return pd.DataFrame(records)\n",
	"\n",
	"def parse_labels(value: Any) -> List[str]:\n",
	" if value is None:\n",
	" return []\n",
	" if isinstance(value, list):\n",
	" labels = value\n",
	" elif isinstance(value, str):\n",
	" value = value.strip()\n",
	" if not value:\n",
	" return []\n",
	" if value.startswith("["):\n",
	" try:\n",
	" parsed = json.loads(value)\n",
	" labels = parsed if isinstance(parsed, list) else [value]\n",
	" except json.JSONDecodeError:\n",
	" labels = re.split(r"[,;|]", value)\n",
	" else:\n",
	" labels = re.split(r"[,;|]", value)\n",
	" else:\n",
	" labels = [str(value)]\n",
	"\n",
	" cleaned_labels = []\n",
	" for label in labels:\n",
	" label = str(label).strip().lower()\n",
	" if label:\n",
	" cleaned_labels.append(label)\n",
	" return sorted(set(cleaned_labels))\n",
	"\n",
	"def filter_rare_labels(df: pd.DataFrame, label_col: str, min_count: int) -> pd.DataFrame:\n",
	" label_counts = Counter(label for labels in df[label_col] for label in labels)\n",
	" valid_labels = {label for label, count in label_counts.items() if count >= min_count}\n",
	"\n",
	" df = df.copy()\n",
	" df[label_col] = df[label_col].apply(lambda labels: sorted(label for label in labels if label in valid_labels))\n",
	" df = df[df[label_col].map(len) > 0].reset_index(drop=True)\n",
	"\n",
	" print(f"Počet labelov po filtrovaní: {len(valid_labels)}")\n",
	" print(f"Odstránené labely s výskytom menším ako {min_count}.")\n",
	" return df\n",
	"\n",
	"def multilabel_train_test_split(X: Sequence[Any], y: np.ndarray, test_size: float, random_state: int) -> Tuple[np.ndarray, np.ndarray]:\n",
	" indices = np.arange(len(X))\n",
	" try:\n",
	" from iterstrat.ml_stratifiers import MultilabelStratifiedShuffleSplit\n",
	" splitter = MultilabelStratifiedShuffleSplit(n_splits=1, test_size=test_size, random_state=random_state)\n",
	" train_idx, test_idx = next(splitter.split(np.zeros(len(indices)), y))\n",
	" return train_idx, test_idx\n",
	" except ImportError:\n",
	" print("Balík iterative-stratification nie je nainštalovaný. Používam obyčajný train_test_split.")\n",
	" train_idx, test_idx = train_test_split(indices, test_size=test_size, random_state=random_state)\n",
	" return train_idx, test_idx\n",
	"\n",
	"def get_positive_class_proba(classifier: OneVsRestClassifier, X: Any) -> np.ndarray:\n",
	" probabilities = classifier.predict_proba(X)\n",
	" if isinstance(probabilities, list):\n",
	" probabilities = np.vstack([item[:, 1] for item in probabilities]).T\n",
	" return np.asarray(probabilities)\n",
	"\n",
	"def tune_thresholds(y_true: np.ndarray, y_proba: np.ndarray, threshold_grid: np.ndarray) -> np.ndarray:\n",
	" thresholds = np.full(y_true.shape[1], 0.5, dtype=float)\n",
	" for label_idx in range(y_true.shape[1]):\n",
	" if y_true[:, label_idx].sum() == 0:\n",
	" continue\n",
	" best_threshold = 0.5\n",
	" best_score = -1.0\n",
	" for threshold in threshold_grid:\n",
	" y_pred_label = (y_proba[:, label_idx] >= threshold).astype(int)\n",
	" score = f1_score(y_true[:, label_idx], y_pred_label, zero_division=0)\n",
	" if score > best_score:\n",
	" best_score = score\n",
	" best_threshold = threshold\n",
	" thresholds[label_idx] = best_threshold\n",
	" return thresholds\n",
	"\n",
	"def apply_thresholds(y_proba: np.ndarray, thresholds: np.ndarray, ensure_at_least_one_label: bool = True) -> np.ndarray:\n",
	" y_pred = (y_proba >= thresholds).astype(int)\n",
	" if ensure_at_least_one_label:\n",
	" empty_rows = np.where(y_pred.sum(axis=1) == 0)[0]\n",
	" if len(empty_rows) > 0:\n",
	" best_label_indices = np.argmax(y_proba[empty_rows], axis=1)\n",
	" y_pred[empty_rows, best_label_indices] = 1\n",
	" return y_pred\n",
	"\n",
	"_LANGDETECT_AVAILABLE = None\n",
	"\n",
	"\n",
	"def is_probably_czech(text: str) -> bool:\n",
	" global _LANGDETECT_AVAILABLE\n",
	"\n",
	" if not FILTER_NON_CZECH:\n",
	" return True\n",
	"\n",
	" if _LANGDETECT_AVAILABLE is False:\n",
	" return True\n",
	"\n",
	" try:\n",
	" from langdetect import DetectorFactory, detect_langs\n",
	"\n",
	" _LANGDETECT_AVAILABLE = True\n",
	" DetectorFactory.seed = RANDOM_STATE\n",
	" sample = text[:5000]\n",
	" detected_languages = detect_langs(sample)\n",
	" return any(\n",
	" item.lang == "cs" and item.prob >= MIN_CZECH_PROB\n",
	" for item in detected_languages\n",
	" )\n",
	" except ImportError:\n",
	" if _LANGDETECT_AVAILABLE is None:\n",
	" print(\n",
	" "Balík langdetect nie je nainštalovaný. "\n",
	" "Jazykový filter sa vypína."\n",
	" )\n",
	" _LANGDETECT_AVAILABLE = False\n",
	" return True\n",
	" except Exception:\n",
	" return False"
