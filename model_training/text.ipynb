	" ".content",\n",
	" ".main",\n",
	" ".article",\n",
	" ".post",\n",
	" ".entry",\n",
	" ]:\n",
	" try:\n",
	" selected = soup.select(selector)\n",
	" except Exception:\n",
	" selected = []\n",
	" for node in selected:\n",
	" txt = node.get_text(" ", strip=True)\n",
	" if len(txt) >= 200:\n",
	" main_candidates.append(txt)\n",
	"\n",
	" if main_candidates:\n",
	" main_text = max(main_candidates, key=len)\n",
	" else:\n",
	" main_text = soup.get_text(separator=" ", strip=True)\n",
