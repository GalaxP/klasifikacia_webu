	"\n",
	" for t_idx in true_pos:\n",
	" # If the true label was NOT predicted, record what was predicted instead\n",
	" if t_idx not in pred_pos:\n",
	" for p_idx in pred_pos:\n",
	" # If the model predicted p_idx while missing t_idx\n",
	" confusion_mat[t_idx, p_idx] += 1\n",
	" # Optionally, you could also include cases where t_idx was predicted\n",
	" # but another label was also added, but that's not a misclassification of t_idx.\n",
	"\n",
	"# Plot heatmap\n",
	"plt.figure(figsize=(10, 8))\n",
	"sns.heatmap(\n",
