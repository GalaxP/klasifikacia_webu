	"class TextProcessor:\n",
	" def init(self) -> None:\n",
	" self.stop_words = CZECH_STOPWORDS\n",
	" self.nlp = None\n",
	"\n",
	" if USE_STANZA_LEMMATIZATION:\n",
	" try:\n",
	" import os\n",
	" import stanza\n",
	"\n",
	" model_dir = os.path.join(os.path.expanduser("~"), ".stanza")\n",
	" cs_model_path = os.path.join(model_dir, "models", "cs")\n",
	"\n",
	" if not os.path.exists(cs_model_path):\n",
	" print("Sťahujem český model pre Stanza...")\n",
	" stanza.download("cs", verbose=False)\n",
	"\n",
	" self.nlp = stanza.Pipeline(\n",
	" lang="cs",\n",
	" processors="tokenize,pos,lemma",\n",
	" use_gpu=False,\n",
	" verbose=False,\n",
	" )\n",
	" print("Používam Stanza český model na lematizáciu.")\n",
	" except Exception as exc:\n",
	" print(\n",
	" "Stanza český model sa nepodarilo načítať. "\n",
	" f"Pokračujem bez lematizácie. Detail: {exc}"\n",
	" )\n",
	" self.nlp = None\n",
	"\n",
	" def decompress_html(self, value: Any) -> str:\n",
	" if value is None:\n",
	" return ""\n",
	" if not isinstance(value, str):\n",
	" value = str(value)\n",
	" value = value.strip()\n",
	" if not value:\n",
	" return ""\n",
	" if (\n",
	" "<html" in value.lower()\n",
	" or "<body" in value.lower()\n",
	" or "<div" in value.lower()\n",
	" ):\n",
	" return value\n",
	"\n",
	" try:\n",
	" decoded = base64.b64decode(value)\n",
	" except Exception:\n",
	" return value\n",
	"\n",
	" try:\n",
	" decompressed = gzip.decompress(decoded)\n",
	" return decompressed.decode("utf-8", errors="ignore")\n",
	" except Exception:\n",
	" try:\n",
	" return decoded.decode("utf-8", errors="ignore")\n",
	" except Exception:\n",
	" return ""\n",
	"\n",
	" def _extract_meta_content(\n",
	" self, soup: BeautifulSoup, names: Iterable[str]\n",
	" ) -> List[str]:\n",
	" values: List[str] = []\n",
	" for name in names:\n",
	" meta = soup.find("meta", attrs={"name": name})\n",
	" if meta and meta.get("content"):\n",
	" values.append(str(meta["content"]))\n",
	" return values\n",
	"\n",
	" def _drop_boilerplate_nodes(self, soup: BeautifulSoup) -> None:\n",
	" for comment in soup.find_all(\n",
	" string=lambda item: isinstance(item, Comment)\n",
	" ):\n",
	" comment.extract()\n",
	"\n",
	" for tag in soup(\n",
	" [\n",
	" "script",\n",
	" "style",\n",
	" "noscript",\n",
	" "svg",\n",
	" "canvas",\n",
	" "iframe",\n",
	" "form",\n",
	" "nav",\n",
	" "footer",\n",
	" "aside",\n",
	" "template",\n",
	" "dialog",\n",
	" ]\n",
	" ):\n",
	" tag.decompose()\n",
	"\n",
	" noisy_keywords = {\n",
	" "cookie",\n",
	" "cookies",\n",
	" "consent",\n",
	" "gdpr",\n",
	" "privacy",\n",
	" "newsletter",\n",
	" "subscribe",\n",
	" "popup",\n",
	" "modal",\n",
	" "banner",\n",
	" "advert",\n",
	" "ads",\n",
	" "promo",\n",
	" "breadcrumb",\n",
	" "login",\n",
	" "signin",\n",
	" "register",\n",
	" "cart",\n",
	" "basket",\n",
	" "menu",\n",
	" "sidebar",\n",
	" "footer",\n",
	" "header",\n",
	" "toolbar",\n",
	" "pagination",\n",
	" "sharing",\n",
	" "social",\n",
	" "filter",\n",
	" "sort",\n",
	" "search",\n",
	" "recommend",\n",
	" "related",\n",
	" }\n",
	"\n",
	" tags = list(soup.find_all(True))\n",
	"\n",
	" for tag in reversed(tags):\n",
	" if tag is None:\n",
	" continue\n",
	"\n",
	" attrs = getattr(tag, "attrs", None)\n",
	" if attrs is None:\n",
	" continue\n",
	"\n",
	" class_attr = tag.get("class", [])\n",
	" if isinstance(class_attr, (list, tuple)):\n",
	" class_text = " ".join(map(str, class_attr))\n",
	" else:\n",
	" class_text = str(class_attr or "")\n",
	"\n",
	" attrs_to_check = [\n",
	" str(tag.get("id", "") or ""),\n",
	" class_text,\n",
	" str(tag.get("role", "") or ""),\n",
	" str(tag.get("aria-label", "") or ""),\n",
	" ]\n",
	" attrs_text = " ".join(x.lower() for x in attrs_to_check if x)\n",
	"\n",
	" if any(keyword in attrs_text for keyword in noisy_keywords):\n",
	" tag.decompose()\n",
	" continue\n",
	"\n",
	" style = str(tag.get("style", "") or "").lower()\n",
	" if (\n",
	" "display:none" in style\n",
	" or "visibility:hidden" in style\n",
	" or "opacity:0" in style\n",
	" ):\n",
	" tag.decompose()\n",
	"\n",
	" def _extract_main_text_trafilatura(self, html_text: str) -> str:\n",
	" try:\n",
	" import trafilatura\n",
	"\n",
	" extracted = trafilatura.extract(\n",
	" html_text,\n",
	" include_comments=False,\n",
	" include_tables=False,\n",
	" include_formatting=False,\n",
	" include_links=False,\n",
	" favor_precision=True,\n",
	" deduplicate=True,\n",
	" )\n",
	" return extracted or ""\n",
	" except Exception:\n",
	" return ""\n",
	"\n",
	" def _deduplicate_lines(self, text: str) -> str:\n",
	" parts = [\n",
	" part.strip()\n",
	" for part in re.split(r"[\n\r]+|(?<=[.!?])\s{2,}", text)\n",
	" if part.strip()\n",
	" ]\n",
	"\n",
	" if not parts:\n",
	" return text\n",
	"\n",
	" counts = Counter(parts)\n",
	" cleaned_parts: List[str] = []\n",
	"\n",
	" for part in parts:\n",
	" if counts[part] > 3:\n",
	" continue\n",
	" cleaned_parts.append(part)\n",
	"\n",
	" return " ".join(cleaned_parts)\n",
	"\n",
	" def _remove_boilerplate_phrases(self, text: str) -> str:\n",
	" patterns = [\n",
	" r"používáme cookies[^.]{0,300}",\n",
	" r"tato stránka používá cookies[^.]{0,300}",\n",
	" r"používáme soubory cookies[^.]{0,300}",\n",
	" r"zásady ochrany osobních údajů[^.]{0,300}",\n",
	" r"ochrana osobních údajů[^.]{0,300}",\n",
	" r"nastavení soukromí[^.]{0,300}",\n",
	" r"personalizovan[ýaé] reklam[ay][^.]{0,300}",\n",
	" r"oprávněn[ýe] zájem[^.]{0,300}",\n",
	" r"využíváme vaše údaje[^.]{0,300}",\n",
	" r"spravovat souhlas[^.]{0,300}",\n",
	" r"kliknutím na[^.]{0,200}souhlas",\n",
	" r"přihl[aá]sit se",\n",
	" r"registrovat se",\n",
	" r"vložit do košíku",\n",
	" r"přidat do košíku",\n",
	" r"dostupnost na prodejně",\n",
