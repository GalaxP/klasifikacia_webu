+def gzip_b64_decompress(data: str) -> str:
+    """Dekóduje base64 + gzip text do UTF-8 reťazca."""
+    if not data:
+        return ""
+    raw = base64.b64decode(data)
+    return gzip.decompress(raw).decode("utf-8", errors="replace")
+
+
+def gzip_b64_compress(text: str) -> str:
+    """Zakóduje UTF-8 reťazec do gzip + base64."""
+    if text is None:
+        text = ""
+    raw = gzip.compress(text.encode("utf-8"))
+    return base64.b64encode(raw).decode("ascii")
+
